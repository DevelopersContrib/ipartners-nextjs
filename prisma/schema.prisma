  DateSubmitted   DateTime?                         @db.DateTime(0)
  SponsorImage    String?                           @db.VarChar(255)
  SponsorURL      String?                           @db.VarChar(255)
  Approved        ChallengeSponsor_Approved?        @default(dbgenerated("0"))
  EquityPoints    String?                           @db.VarChar(100)
  Details         String?                           @db.Text
  SponsorTitle    String?                           @db.VarChar(200)
  service         String?                           @db.Text
  payment_id      Int?
  transaction_id  String?                           @db.VarChar(250)
}

model ChallengeSponsorhipTypes {
  id       Int     @id @default(autoincrement())
  name     String? @db.VarChar(100)
  val_name String? @db.VarChar(100)
}

model ChallengeSponsorhipTypesList {
  id           Int  @id @default(autoincrement())
  Challenge_Id Int
  type_id      Int?
}

model ChallengeSponsorshipPayments {
  payment_id       BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  member_id        Int
  ChallengeId      Int
  datetime_created DateTime @default(now()) @db.Timestamp(0)
  transaction_id   String?  @db.Text
  token            String?  @db.Text
  amount           Float?   @db.Float
  currency         String?  @db.VarChar(3)
  status           String?  @db.Text
  firstname        String?  @db.Text
  lastname         String?  @db.Text
  email            String?  @db.Text
  description      String?  @db.Text
  summary          String?  @db.Text
}

model ChallengeTokenPrice {
  id          Int     @id @default(autoincrement()) @db.UnsignedInt
  ChallengeId Int
  token       String? @db.VarChar(255)
  currency    String? @db.VarChar(100)
  amount      Float?
  chainId     Int?    @default(4)
}

model Challenge_AppFiles {
  FileId   Int    @id @default(autoincrement())
  AppId    Int
  FilePath String @db.VarChar(100)
}

model Challenge_AppImages {
  ImageId   Int    @id @default(autoincrement())
  AppId     Int
  ImagePath String @db.VarChar(225)
}

model Challenge_AppVideo {
  VideoId Int    @id @default(autoincrement())
  AppId   Int
  Url     String @db.Text
}

model Challenge_Criteria {
  CriteriaId          Int    @id @default(autoincrement())
  ChallengeId         Int
  CriteriaDescription String @db.MediumText
}

model Challenge_HowToEnter {
  HowToId     Int    @id @default(autoincrement())
  ChallengeId Int
  HowToDesc   String @db.MediumText
}

model Challenge_Prizes {
  PrizeId          Int    @id @default(autoincrement())
