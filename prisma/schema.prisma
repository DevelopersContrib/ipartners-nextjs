}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Challenge_Solution {
  ChallengeSolution Int                        @id @default(autoincrement()) @db.UnsignedInt
  Solution          String                     @db.Text
  SolutionTitle     String?                    @db.VarChar(50)
  Attachment        String?                    @db.VarChar(100)
  DatePosted        DateTime                   @db.DateTime(0)
  ChallengeId       Int                        @db.UnsignedInt
  ChallengeMemberId Int                        @db.UnsignedInt
  Approve           Challenge_Solution_Approve @default(dbgenerated("0"))
  in_equity         Int?                       @default(0)
  wallet_address    String?                    @db.VarChar(255)
  transaction_id    String?                    @db.VarChar(255)
  chainId           Int?                       @default(4) @db.TinyInt
}

model Challenge_Timeline {
  TimelineId        Int      @id @default(autoincrement())
  ChallengeId       Int
  Submission_From   DateTime @db.Date
  Submission_To     DateTime @db.Date
  Judging_From      DateTime @db.Date
  Judging_To        DateTime @db.Date
  Winners_Announced DateTime @db.Date
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Challenges {
  ChallengeId       Int                        @id @default(autoincrement()) @db.UnsignedInt
  ChallengeTitle    String                     @db.VarChar(200)
  ChallengeDesc     String                     @db.Text
  MoreDetails       String                     @db.Text
  Photo             String                     @db.VarChar(150)
  CategoryId        Int
  DatePosted        DateTime                   @db.DateTime(0)
  Solved            Challenges_Solved          @default(dbgenerated("0"))
  URLName           String                     @db.VarChar(20)
  Approved          Challenges_Approved        @default(dbgenerated("0"))
  Slug              String?                    @db.VarChar(200)
  short_desc        String                     @db.VarChar(1000)
  font_style        String                     @db.VarChar(50)
  font_size         Int
  bg_color          String                     @db.VarChar(50)
  EquityPoints      Int?                       @default(0)
  is_featured       Challenges_is_featured?    @default(dbgenerated("0"))
  is_onboarding     Int?                       @default(0)
  contribution_type Int?                       @default(1)
  ParentId          Int?                       @default(0)
  HashTag           String?                    @db.VarChar(200)
  CashPrize         Float?                     @default(0) @db.Float
  DaysRequired      Int?                       @default(0)
  enable_quiz       Int?                       @default(0)
  challenge_type    Challenges_challenge_type? @default(onboarding)
  MemberId          Int?
  FromDomain        String?                    @db.VarChar(200)
  IsApproved        Boolean?                   @default(true)
}

model Challenges_Featured {
  id          Int @id @default(autoincrement())
  ChallengeId Int
}

