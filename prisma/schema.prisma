// ipartners.com — partner portal over the existing VNOC partnership system (contrib_rdb).
//
// ⛔ NEVER run `prisma db push` or `prisma migrate*` against this DB.
// contrib_rdb is SHARED PRODUCTION. MarketPartnership alone powers a public widget
// on ~30k domains. Prisma treats this schema as the FULL database and would DROP
// every table not listed here.
//
// Schema changes are hand-written additive SQL under prisma/migrations/, applied with:
//   npm run db:check prisma/migrations/<file>.sql   # dry-run safety scan
//   npm run db:apply prisma/migrations/<file>.sql   # apply (ipp_ tables only)
// scripts/db-apply.mjs REFUSES any DROP/TRUNCATE/RENAME outside the `ipp_` prefix.
//
// Everything we OWN is prefixed `ipp_`. Everything else below models EXISTING tables
// that we read (and, where noted, write through vetted paths) but never migrate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("CONTRIB_DATABASE_URL")
}

// ─────────────────────────── OURS (ipp_) ───────────────────────────

/// One-time 6-digit sign-in codes. Replaces the legacy password auth that sent
/// credentials over plain HTTP in a query string.
model IppAuthCode {
  token     String   @id @db.VarChar(191)
  email     String   @db.VarChar(191)
  code      String   @db.VarChar(12)
  attempts  Int      @default(0)
  next      String?  @db.VarChar(255)
  /// Present on signup codes — written into ipp_partners on successful verify.
  firstName String?  @map("first_name") @db.VarChar(100)
  lastName  String?  @map("last_name") @db.VarChar(100)
  company   String?  @db.VarChar(191)
  expiresAt DateTime @map("expires_at")
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email], map: "idx_ipp_auth_codes_email")
  @@map("ipp_auth_codes")
}

/// Brand-new partners who signed up here but are not (yet) in contrib Members.
model IppPartner {
  email     String   @id @db.VarChar(191)
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  company   String?  @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ipp_partners")
}

/// One partner × one mode × one scope. Central Phase 2 object.
/// Never backfill mode=sponsor — that starts empty until Phase 3 checkout.
model IppEngagement {
  id          BigInt    @id @default(autoincrement())
  memberId    BigInt?   @map("member_id")
  email       String    @db.VarChar(255)
  mode        String    @db.VarChar(32)
  scopeType   String    @default("domain") @map("scope_type") @db.VarChar(16)
  scopeValue  String?   @map("scope_value") @db.VarChar(255)
  status      String    @default("pending") @db.VarChar(24)
  tier        String?   @db.VarChar(32)
  termStart   DateTime? @map("term_start") @db.Date
  termEnd     DateTime? @map("term_end") @db.Date
  sourceTable String?   @map("source_table") @db.VarChar(64)
  sourceId    BigInt?   @map("source_id")
  /// JSON blob of apply-form answers for admin review (optional).
  applicationJson String? @map("application_json") @db.MediumText
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([sourceTable, sourceId], map: "uq_source")
  @@index([email], map: "idx_email")
  @@index([memberId], map: "idx_member")
  @@index([mode, status], map: "idx_mode_status")
  @@index([scopeType, scopeValue], map: "idx_scope")
  @@map("ipp_engagement")
}

/// SES campaign send log — one row per (engagement, campaign_key) for idempotency.
model IppCampaignSend {
  id           BigInt   @id @default(autoincrement())
  engagementId BigInt   @map("engagement_id")
  campaignKey  String   @map("campaign_key") @db.VarChar(64)
  email        String   @db.VarChar(255)
  sendStatus   String   @default("sent") @map("send_status") @db.VarChar(24)
  providerId   String?  @map("provider_id") @db.VarChar(191)
  error        String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([engagementId, campaignKey], map: "uq_engagement_campaign")
  @@index([email], map: "idx_campaign_email")
  @@index([campaignKey], map: "idx_campaign_key")
  @@map("ipp_campaign_send")
}

/// Partner AI agent chat (pending qualification → recommend approve → Growagent).
model IppAgentMessage {
  id           BigInt   @id @default(autoincrement())
  engagementId BigInt   @map("engagement_id")
  email        String   @db.VarChar(255)
  role         String   @db.VarChar(16)
  content      String   @db.MediumText
  metaJson     String?  @map("meta_json") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([engagementId], map: "idx_engagement")
  @@index([email], map: "idx_email")
  @@index([createdAt], map: "idx_created")
  @@map("ipp_agent_message")
}

// ───────────────────── EXISTING — read/write, never migrate ─────────────────────

/// Contrib member store (108k rows) — the identity source of truth.
/// We match on EmailAddress; MemberId links to MarketPartnership.member_id.
model Members {
  MemberId      Int       @id
  Username      String?   @db.VarChar(255)
  EmailAddress  String?   @db.VarChar(255)
  FirstName     String?   @db.VarChar(255)
  LastName      String?   @db.VarChar(255)
  CompanyName   String?   @db.VarChar(255)
  Website       String?   @db.VarChar(255)
  /// NOT NULL in the DB, and holds a country NAME ("United States"), with
  /// inconsistent casing ("philippines"). The iPartner_* tables store IDs
  /// instead — see resolveOption in ApplicationForm.
  Country       String    @db.VarChar(225)
  SignupDate    DateTime?
  LastLogin     DateTime?

  @@map("Members")
}

/// Published partnerships (81k rows) — renders publicly via the contrib partners
/// widget on ~30k domains. READ-ONLY here; publishing stays in manage-app.
model MarketPartnership {
  partner_id      Int      @id
  company_name    String?  @db.VarChar(255)
  domain          String?  @db.VarChar(255)
  url             String?  @db.VarChar(255)
  summary         String?  @db.Text
  member_id       BigInt?
  approved        Int?     @db.TinyInt
  approved_status String?  @db.VarChar(255)
  type            String?  @db.VarChar(255)
  slug            String?  @db.VarChar(255)
  in_equity       Int?
  date_applied    DateTime?

  @@map("MarketPartnership")
}

/// General partnership applications (intake). 1,323 rows, ~1,308 unreviewed.
model IPartner {
  ipartner_id        Int       @id @default(autoincrement())
  firstname          String?   @db.VarChar(25)
  lastname           String?   @db.VarChar(25)
  email              String?   @db.VarChar(50)
  phone              String?   @db.VarChar(25)
  linkedin           String?   @db.VarChar(100)
  employer           String?   @db.VarChar(100)
  location           String?   @db.VarChar(255)
  domain_name        String?   @db.VarChar(50)
  industry           String?   @db.VarChar(50)
  time_commitment    String?   @db.VarChar(25)
  areas_of_expertise String?   @db.Text
  concept_ideas      String?   @db.Text
  resources          String?   @db.Text
  partnership_goals  String?   @db.Text
  business_advice    String?   @db.Text
  resources_needed   String?   @db.Text
  expectations       String?   @db.Text
  status             Int?      @db.TinyInt
  date_submitted     DateTime?

  @@map("IPartner")
}

/// Domain-partnership applications — INBOUND: external owners bringing their own
/// portfolios. (Distinct from our outbound catalog; do not conflate.)
model iPartner_Domain {
  ipartner_domain_id Int       @id
  first_name         String?   @db.VarChar(255)
  last_name          String?   @db.VarChar(255)
  company            String?   @db.VarChar(255)
  title              String    @db.VarChar(100)
  phone_number       String?   @db.VarChar(20)
  /// FK-style ids that line up with the /api/countries and /api/config option
  /// lists — usable for prefill directly, unlike Members.Country.
  country            Int
  industry_id        Int
  email              String?   @db.VarChar(255)
  domain             String?   @db.Text
  domains_owned      String?   @db.Text
  develop_or_sell    String?   @db.VarChar(255)
  status             String?
  date_submitted     DateTime?

  @@map("iPartner_Domain")
}

// The three variant tables share a shape: PK `ipartner_id`, `fname`/`lname`,
// `email`, `domain`, `app_status`, `date_submitted`.

model iPartner_AppLeader {
  ipartner_id    Int       @id
  domain         String?   @db.VarChar(255)
  fname          String?   @db.VarChar(255)
  lname          String?   @db.VarChar(255)
  email          String?   @db.VarChar(255)
  industry       String?   @db.VarChar(255)
  app_status     String?   @db.VarChar(255)
  date_submitted DateTime?

  @@map("iPartner_AppLeader")
}

model iPartner_ProductService {
  ipartner_id          Int       @id
  domain               String?   @db.VarChar(255)
  fname                String?   @db.VarChar(255)
  lname                String?   @db.VarChar(255)
  email                String?   @db.VarChar(255)
  company              String?   @db.VarChar(255)
  product_service_name String?   @db.VarChar(255)
  app_status           String?   @db.VarChar(255)
  date_submitted       DateTime?

  @@map("iPartner_ProductService")
}

model iPartner_VentureLeader {
  ipartner_id    Int       @id
  domain         String?   @db.VarChar(255)
  fname          String?   @db.VarChar(255)
  lname          String?   @db.VarChar(255)
  email          String?   @db.VarChar(255)
  industry       String?   @db.VarChar(255)
  app_status     String?   @db.VarChar(255)
  date_submitted DateTime?

  @@map("iPartner_VentureLeader")
}
