generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BadgeActivity {
  activity_id Int     @id @default(autoincrement())
  label       String? @db.VarChar(200)
  class       String? @db.VarChar(100)
  points      Int?
}

model BadgeMemberActivityPoints {
  point_id               Int      @id @default(autoincrement())
  member_id              Int
  activity_id            Int
  points                 Int
  message                String?  @db.VarChar(250)
  date_earned            DateTime @default(now()) @db.Timestamp(0)
  domain                 String?  @db.VarChar(200)
  referrence_id          String?  @db.VarChar(100)
  is_active              Int?     @default(1)
  blockchain_transaction String?  @db.VarChar(200)
}

model BadgeMemberPoints {
  point_id    Int      @id @default(autoincrement())
  member_id   Int
  activity_id Int
  points      Int
  date_earned DateTime @default(now()) @db.Timestamp(0)
  message     String?  @db.VarChar(250)
  is_active   Int?     @default(1)
}

model BannedIpAddresses {
  id     Int     @id @default(autoincrement())
  ip_add String? @db.VarChar(200)
}

model Category {
  category_id   Int     @id @default(autoincrement())
  category_name String  @db.VarChar(200)
  board_id      Int?    @default(0)
  holding_url   String? @db.VarChar(100)
  description   String? @db.Text
  image         String? @db.VarChar(255)
  map_color     String? @db.VarChar(100)
}

model ChallengeAttributes {
  ChallengeAtrributeId Int      @id @default(autoincrement())
  DomainId             Int?     @unique(map: "domain_id")
  Introduction         String?  @db.Text
  IntroTitle           String?  @db.VarChar(250)
  ChallengeKey         Int?
  CategoryId           Int?
  TemplateColor        String?  @default("lightblue") @db.VarChar(100)
  HeaderScript         String?  @db.Text
  CustomHtml           String?  @db.Text
  Desc_Graphics        String?  @db.VarChar(200)
  UseSocialLogin       Boolean? @default(false)
}

model ChallengeBlockChain {
  Id                  Int      @id @default(autoincrement())
  ChallengeId         Int
  blockhain_domain_id BigInt
  prize_currency      String?  @default("ESH") @db.VarChar(20)
  prize_amount        Float?   @default(0) @db.Float
