  QuizId      Int?     @default(0)
}

model ChallengeSponsor {
  SponsorshipId   Int                               @id @default(autoincrement())
  ChallengeId     Int
  SponsorshipType ChallengeSponsor_SponsorshipType?
  SponsorId       Int
