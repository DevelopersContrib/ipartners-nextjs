}

model ChallengeCategory {
  ChallengeCategoryId Int    @id @default(autoincrement()) @db.UnsignedInt
  CategoryName        String @db.VarChar(128)
}

model ChallengeDiscussion {
  discussion_id Int       @id @default(autoincrement())
  member_id     Int?
  challenge_id  Int?
  message       String?   @db.Text
  date_posted   DateTime? @db.DateTime(0)
}

model ChallengeDomainsForTools {
  Id           Int    @id @default(autoincrement())
  Challenge_Id Int
  DomainName   String @db.VarChar(150)
}

model ChallengeEshTransactions {
  id                  Int      @id @default(autoincrement()) @db.UnsignedInt
  transaction_id      String   @db.VarChar(250)
  receiver_address    String   @db.VarChar(250)
  receiver_domain     String   @db.VarChar(100)
  from_address        String   @db.VarChar(250)
  amount              Float    @db.Float
  member_id           Int
  challenge_id        Int
  date_of_transaction DateTime @default(now()) @db.Timestamp(0)
}

model ChallengeLinks {
  LinkId      Int     @id @default(autoincrement())
  ChallengeId Int
  Name        String  @db.VarChar(200)
  Description String? @db.Text
  Link        String  @db.VarChar(200)
}

model ChallengeMemberTypes {
  id              Int                        @id @default(autoincrement())
  member_id       Int
  type            ChallengeMemberTypes_type? @default(challenger)
  date_registered DateTime                   @default(now()) @db.Timestamp(0)
}

model ChallengeRequirementEntry {
  EntryId     Int      @id @default(autoincrement())
  ReqId       Int
  Entry       String?  @db.Text
