# ============================================================
# iPartner.com - Apache Rewrite Rules
# For use when deploying behind Apache (e.g., reverse proxy)
# If deploying on Vercel, these are handled by next.config.ts
# ============================================================

RewriteEngine On

# ---- Force HTTPS ----
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- Subdomain to Path Redirects ----
# Redirect domain.ipartner.com/* -> ipartner.com/domain/*
RewriteCond %{HTTP_HOST} ^domain\.ipartner\.com$ [NC]
RewriteRule ^(.*)$ https://ipartner.com/domain/$1 [R=301,L]

# Redirect apps.ipartner.com/* -> ipartner.com/apps/*
RewriteCond %{HTTP_HOST} ^apps\.ipartner\.com$ [NC]
RewriteRule ^(.*)$ https://ipartner.com/apps/$1 [R=301,L]

# Redirect leaders.ipartner.com/* -> ipartner.com/leaders/*
RewriteCond %{HTTP_HOST} ^leaders\.ipartner\.com$ [NC]
RewriteRule ^(.*)$ https://ipartner.com/leaders/$1 [R=301,L]

# Redirect product-service.ipartner.com/* -> ipartner.com/product-service/*
RewriteCond %{HTTP_HOST} ^product-service\.ipartner\.com$ [NC]
RewriteRule ^(.*)$ https://ipartner.com/product-service/$1 [R=301,L]

# ---- Legacy .html to Clean URLs ----
RewriteRule ^about\.html$ /about [R=301,L]
RewriteRule ^contact\.html$ /contact [R=301,L]
RewriteRule ^privacy\.html$ /privacy [R=301,L]
RewriteRule ^terms\.html$ /terms [R=301,L]

# ---- Legacy .php to Clean URLs ----
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^about\.php$ /about [R=301,L]
RewriteRule ^contact\.php$ /contact [R=301,L]
RewriteRule ^privacy\.php$ /privacy [R=301,L]
RewriteRule ^terms\.php$ /terms [R=301,L]
RewriteRule ^appleader\.php$ /leaders/apply [R=301,L]
RewriteRule ^phase2\.php$ /domain/apply [R=301,L]

# ---- Partnership PHP Redirects ----
RewriteRule ^domain/index\.php$ /domain [R=301,L]
RewriteRule ^domain/apply_form\.php$ /domain/apply [R=301,L]
RewriteRule ^domain/apply_form2\.php$ /domain/apply [R=301,L]
RewriteRule ^domain/about\.php$ /about [R=301,L]
RewriteRule ^domain/contact\.php$ /contact [R=301,L]
RewriteRule ^domain/privacy\.php$ /privacy [R=301,L]
RewriteRule ^domain/terms\.php$ /terms [R=301,L]
RewriteRule ^domain/ajaxrequest\.php$ /api/auth [R=301,L]

RewriteRule ^apps/index\.php$ /apps [R=301,L]
RewriteRule ^apps/apply_form\.php$ /apps/apply [R=301,L]
RewriteRule ^apps/about\.php$ /about [R=301,L]
RewriteRule ^apps/contact\.php$ /contact [R=301,L]

RewriteRule ^leaders/index\.php$ /leaders [R=301,L]
RewriteRule ^leaders/apply_form\.php$ /leaders/apply [R=301,L]
RewriteRule ^leaders/about\.php$ /about [R=301,L]
RewriteRule ^leaders/contact\.php$ /contact [R=301,L]

RewriteRule ^product-service/index\.php$ /product-service [R=301,L]
RewriteRule ^product-service/apply_form\.php$ /product-service/apply [R=301,L]
RewriteRule ^product-service/about\.php$ /about [R=301,L]
RewriteRule ^product-service/contact\.php$ /contact [R=301,L]

# ---- Partnership .html Redirects ----
RewriteRule ^domain/about\.html$ /about [R=301,L]
RewriteRule ^domain/contact\.html$ /contact [R=301,L]
RewriteRule ^domain/privacy\.html$ /privacy [R=301,L]
RewriteRule ^domain/terms\.html$ /terms [R=301,L]

RewriteRule ^apps/about\.html$ /about [R=301,L]
RewriteRule ^apps/contact\.html$ /contact [R=301,L]

RewriteRule ^leaders/about\.html$ /about [R=301,L]
RewriteRule ^leaders/contact\.html$ /contact [R=301,L]

RewriteRule ^product-service/about\.html$ /about [R=301,L]
RewriteRule ^product-service/contact\.html$ /contact [R=301,L]

# ---- Block Malicious Bots (from original .htaccess) ----
RewriteCond %{HTTP_USER_AGENT} ^BlackWidow [OR]
RewriteCond %{HTTP_USER_AGENT} ^Bot\ mailto:craftbot@yahoo.com [OR]
RewriteCond %{HTTP_USER_AGENT} ^ChinaClaw [OR]
RewriteCond %{HTTP_USER_AGENT} ^Custo [OR]
RewriteCond %{HTTP_USER_AGENT} ^DISCo [OR]
RewriteCond %{HTTP_USER_AGENT} ^Download\ Demon [OR]
RewriteCond %{HTTP_USER_AGENT} ^eCatch [OR]
RewriteCond %{HTTP_USER_AGENT} ^EirGrabber [OR]
RewriteCond %{HTTP_USER_AGENT} ^EmailSiphon [OR]
RewriteCond %{HTTP_USER_AGENT} ^EmailWolf [OR]
RewriteCond %{HTTP_USER_AGENT} ^Express\ WebPictures [OR]
RewriteCond %{HTTP_USER_AGENT} ^ExtractorPro [OR]
RewriteCond %{HTTP_USER_AGENT} ^EyeNetIE [OR]
RewriteCond %{HTTP_USER_AGENT} ^FlashGet [OR]
RewriteCond %{HTTP_USER_AGENT} ^GetRight [OR]
